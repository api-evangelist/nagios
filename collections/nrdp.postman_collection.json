  "info": {
    "_postman_id": "55c2b25e-a416-4265-b973-dfa28b9ee987",
    "name": "NRDP (Nagios Remote Data Processor) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "NRDP is a PHP-based passive result collector for Nagios. It accepts host and\nservice check results and external commands over HTTP POST in either XML or\nJSON form, then injects them into Nagios Core via the external command\npipe. Authentication uses a token configured in `config.inc.php`.\n\n\nContact Support:\n Name: Nagios Enterprises",
      "type": "text/plain"
    }
  }
