  "info": {
    "_postman_id": "a179504f-0bac-4b85-aec6-bf54be9a45c6",
    "name": "NCPA (Nagios Cross-Platform Agent) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API exposed by the Nagios Cross-Platform Agent (NCPA) running on\nLinux, Windows, or macOS. The API uses a hierarchical node-based URL\nstructure (`/api/{module}/{node1}/{node2}`) and is authenticated by a\n`token` query parameter matching the `community_string` in the agent\nconfig. Both active polls and Nagios-style passive check results are\nsupported.\n\n\nContact Support:\n Name: Nagios Enterprises",
      "type": "text/plain"
    }
  }
