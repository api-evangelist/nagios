{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nagios XI REST Config Submission API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Submission",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit NRDP Payload",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{nagiosXiHost}/nagiosxi/api/v1/",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                },
                {
                  "name": "cmd",
                  "value": ""
                },
                {
                  "name": "XMLDATA",
                  "value": ""
                },
                {
                  "name": "JSONDATA",
                  "value": ""
                },
                {
                  "name": "command",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Submit a `checkresults` payload (`cmd=submitcheck`) or a Nagios external\ncommand (`cmd=submitcmd`). The body can be `application/x-www-form-urlencoded`\nwith an XML/JSON `XMLDATA`/`JSONDATA` field.\n"
        }
      ]
    }
  ],
  "bundled": true
}