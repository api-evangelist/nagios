          "request": {
            "name": "Submit NRDP Payload",
            "description": {
              "content": "Submit a `checkresults` payload (`cmd=submitcheck`) or a Nagios external\ncommand (`cmd=submitcmd`). The body can be `application/x-www-form-urlencoded`\nwith an XML/JSON `XMLDATA`/`JSONDATA` field.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the Nagios XI server",
                  "type": "any",
                  "value": "{{nagiosXiHost}}",
                  "key": "nagiosXiHost"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) NRDP authentication token."
                },
                {
                  "disabled": false,
                  "key": "cmd",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "XMLDATA",
                  "value": "<string>",
                  "description": "XML payload, root `<checkresults>` containing one or more\n`<checkresult type=\"host|service\">` elements with\n`<hostname>`, `<servicename>`, `<state>`, `<output>` children.\n"
                },
                {
                  "disabled": false,
                  "key": "JSONDATA",
                  "value": "<string>",
                  "description": "JSON string equivalent of XMLDATA — e.g.\n`{\"checkresults\":[{\"checkresult\":{\"type\":\"service\",...}}]}`.\n"
                },
                {
                  "disabled": false,
                  "key": "command",
                  "value": "<string>",
                  "description": "External command string when `cmd=submitcmd`."
                }
              ]
            }
          },
